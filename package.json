{
  "name": "@maxvue/maxpaperclipagyadapter",
  "version": "2.0.1",
  "description": "Adaptador externo seguro do Antigravity CLI (agy) para o Paperclip",
  "license": "MIT",
  "author": "MaxVue contributors",
  "homepage": "https://github.com/maxvue/MaxPaperclipAgyAdapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxvue/MaxPaperclipAgyAdapter.git"
  },
  "bugs": {
    "url": "https://github.com/maxvue/MaxPaperclipAgyAdapter/issues"
  },
  "type": "module",
  "keywords": [
    "paperclip",
    "paperclipai",
    "paperclip-adapter",
    "external-adapter",
    "agent-adapter",
    "antigravity",
    "agy",
    "ai-agent",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui-parser": "./ui-parser.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "files": [
    "dist",
    "ui-parser.cjs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:package"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.916.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
